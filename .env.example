# ─────────────────────────────────────────────────────────────────
# AI4Montage — Environment Variables
# Copy this to .env and fill in your real values
# .env is gitignored — NEVER commit real keys to git
# ─────────────────────────────────────────────────────────────────

# ── Paddle Payment Gateway ────────────────────────────────────────
# Get these from: https://sandbox-vendors.paddle.com → Developer Tools
# Email: nadembadrs1@gmail.com

# Environment: 'sandbox' for testing, 'production' for live
VITE_PADDLE_ENV=sandbox

# Client-side token (starts with test_ for sandbox, or live_ for production)
# Paddle Dashboard → Developer Tools → Authentication → Client-side tokens
VITE_PADDLE_CLIENT_TOKEN=test_REPLACE_WITH_YOUR_TOKEN

# Price IDs — create these in Paddle Dashboard → Catalog → Products → Prices
# Each price gets a unique ID starting with "pri_"
VITE_PADDLE_PRO_MONTHLY=pri_REPLACE_PRO_MONTHLY
VITE_PADDLE_PRO_YEARLY=pri_REPLACE_PRO_YEARLY
VITE_PADDLE_ULTRA_MONTHLY=pri_REPLACE_ULTRA_MONTHLY
VITE_PADDLE_ULTRA_YEARLY=pri_REPLACE_ULTRA_YEARLY

# ── Firebase (already configured via firebase config in code) ─────
# These are safe to expose in client (Firebase Security Rules protect data)
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=...
